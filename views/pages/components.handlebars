<section class="hero-section" style="padding: 1.5rem;">
  <h2>Component Catalogue: Defective vs. Compliant Variants</h2>
  <p class="hero-subtitle">
    Side-by-side controlled component implementations illustrating intentional accessibility defects 
    and their standard-compliant counterparts under WCAG 2.2 Level AA.
  </p>
</section>

<div class="components-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 1.5rem;">
  <!-- Component 1: Actionable Icon Buttons -->
  <article class="card">
    <div class="card-header">
      <h3>1. Icon Buttons (WCAG 1.1.1 & 4.1.2)</h3>
    </div>
    <div class="card-body">
      <div class="variant-comparison">
        <div class="variant defective-variant">
          <span class="variant-tag tag-defect">Defective Variant</span>
          <p>Icon button with empty alt inside; no accessible name exposed.</p>
          <div class="demo-box">
            <button class="btn-icon" id="demo-btn-defect"><img src="/assets/search.svg" alt="" width="24" height="24"></button>
          </div>
        </div>
        <div class="variant compliant-variant">
          <span class="variant-tag tag-compliant">Compliant Variant</span>
          <p>Button with explicit <code>aria-label="Search research catalogue"</code>.</p>
          <div class="demo-box">
            <button class="btn-icon" id="demo-btn-compliant" aria-label="Search research catalogue"><img src="/assets/search.svg" alt="" width="24" height="24"></button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Component 2: Visual Headings -->
  <article class="card">
    <div class="card-header">
      <h3>2. Section Headings (WCAG 1.3.1)</h3>
    </div>
    <div class="card-body">
      <div class="variant-comparison">
        <div class="variant defective-variant">
          <span class="variant-tag tag-defect">Defective Variant</span>
          <p>Styled div with large bold font but missing semantic heading role.</p>
          <div class="demo-box">
            <div class="fake-heading-bold-large">Chapter Overview</div>
          </div>
        </div>
        <div class="variant compliant-variant">
          <span class="variant-tag tag-compliant">Compliant Variant</span>
          <p>Semantic <code>&lt;h3&gt;</code> element properly exposed to document outline.</p>
          <div class="demo-box">
            <h3 style="margin:0;">Chapter Overview</h3>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Component 3: Custom Button Controls -->
  <article class="card">
    <div class="card-header">
      <h3>3. Custom Buttons (WCAG 2.1.1 & 4.1.2)</h3>
    </div>
    <div class="card-body">
      <div class="variant-comparison">
        <div class="variant defective-variant">
          <span class="variant-tag tag-defect">Defective Variant</span>
          <p>Div element with click handler, lacking tabindex and keyboard listener.</p>
          <div class="demo-box">
            <div class="mock-btn" onclick="alert('Defective clicked')">Execute Action</div>
          </div>
        </div>
        <div class="variant compliant-variant">
          <span class="variant-tag tag-compliant">Compliant Variant</span>
          <p>Native <code>&lt;button&gt;</code> with intrinsic keyboard support (Enter/Space).</p>
          <div class="demo-box">
            <button class="btn btn-primary" type="button" onclick="alert('Compliant clicked')">Execute Action</button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Component 4: Label in Name -->
  <article class="card">
    <div class="card-header">
      <h3>4. Label in Name (WCAG 2.5.3)</h3>
    </div>
    <div class="card-body">
      <div class="variant-comparison">
        <div class="variant defective-variant">
          <span class="variant-tag tag-defect">Defective Variant</span>
          <p>Visible text is "Delete Record" but <code>aria-label="Remove Item"</code>.</p>
          <div class="demo-box">
            <button class="btn btn-danger" aria-label="Remove Item">Delete Record</button>
          </div>
        </div>
        <div class="variant compliant-variant">
          <span class="variant-tag tag-compliant">Compliant Variant</span>
          <p>Accessible name starts with visible text: <code>aria-label="Delete Record permanently"</code>.</p>
          <div class="demo-box">
            <button class="btn btn-danger" aria-label="Delete Record permanently">Delete Record</button>
          </div>
        </div>
      </div>
    </div>
  </article>
</div>
