<section class="hero-section" style="padding: 1.5rem;">
  <h2>Four Interactive Dynamic Scenario Fixtures (S1-S4)</h2>
  <p class="hero-subtitle">
    These pages provide interactive examples of changing application states for manual exploration.
    The current automated pilot evaluates static cases only; automated dynamic experiments are planned.
  </p>
</section>

<div class="scenarios-container">
  <!-- Scenario S1: SPA Route Change -->
  <article class="card" id="scenario-s1" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h3>Scenario S1: SPA Route Change (WCAG 2.4.2 & 2.4.3)</h3>
    </div>
    <div class="card-body">
      <p style="margin-bottom: 1rem; color: var(--text-secondary);">
        Demonstrates client-side view switching without full page reload. Evaluates dynamic document title updates, focus placement, and view state exposure.
      </p>
      <div class="interactive-panel">
        <div style="display:flex; gap:0.5rem; margin-bottom: 1rem;">
          <button id="s1-nav-defect" class="btn btn-secondary">Simulate Route Change (Defective: Title Remains Static)</button>
          <button id="s1-nav-compliant" class="btn btn-primary">Simulate Route Change (Compliant: Title & Focus Updated)</button>
        </div>
        <div id="s1-dynamic-view" class="dynamic-view-box" tabindex="-1">
          <h4 id="s1-view-title">Initial View: Overview Dashboard</h4>
          <p id="s1-view-desc">Current View ID: <code>view-overview</code></p>
        </div>
      </div>
    </div>
  </article>

  <!-- Scenario S2: Modal Dialog -->
  <article class="card" id="scenario-s2" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h3>Scenario S2: Modal Dialog (WCAG 2.4.3 & 4.1.2)</h3>
    </div>
    <div class="card-body">
      <p style="margin-bottom: 1rem; color: var(--text-secondary);">
        Interactive fixture for dialog invocation, accessible naming, initial focus, keyboard focus containment, and focus restoration when closed.
      </p>
      <div class="interactive-panel">
        <div style="display:flex; gap:0.5rem; margin-bottom: 1rem;">
          <button id="s2-open-defect" class="btn btn-secondary">Open Defective Modal (No Focus Shift / No Restoration)</button>
          <button id="s2-open-compliant" class="btn btn-primary">Open Compliant Modal (Accessible Focus Trap & Return)</button>
        </div>
        <div id="s2-feedback" style="color: var(--text-secondary); font-size: 0.9rem;">Dialog is currently closed.</div>
      </div>
    </div>
  </article>

  <!-- Scenario S3: Status Message & Live Region -->
  <article class="card" id="scenario-s3" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h3>Scenario S3: Dynamic Status Message (WCAG 4.1.3 & 3.3.2)</h3>
    </div>
    <div class="card-body">
      <p style="margin-bottom: 1rem; color: var(--text-secondary);">
        Interactive fixture for asynchronous submission feedback, with live-region and unannounced text examples.
      </p>
      <div class="interactive-panel">
        <form id="s3-status-form" onsubmit="return false;" style="margin-bottom: 1rem; max-width: 480px;">
          <div style="margin-bottom: 0.75rem;">
            <label for="s3-username" style="display:block; font-weight:600; margin-bottom:0.25rem;">Researcher Identifier</label>
            <input type="text" id="s3-username" class="form-input" value="Dr. A. Turing" style="width:100%; padding:0.5rem;">
          </div>
          <div style="display:flex; gap:0.5rem;">
            <button type="button" id="s3-submit-success" class="btn btn-primary">Simulate Compliant Success (Live Region)</button>
            <button type="button" id="s3-submit-error" class="btn btn-danger">Simulate Compliant Error (Alert)</button>
            <button type="button" id="s3-submit-defect" class="btn btn-secondary">Simulate Defect (No Live Region)</button>
          </div>
        </form>

        <!-- Persistent compliant live regions -->
        <div id="s3-compliant-status-region" role="status" aria-live="polite" class="status-box polite-box"></div>
        <div id="s3-compliant-alert-region" role="alert" aria-live="assertive" class="status-box alert-box"></div>
        <!-- Non-live container for defect demonstration -->
        <div id="s3-defect-container" class="status-box silent-box"></div>
      </div>
    </div>
  </article>

  <!-- Scenario S4: Widget State -->
  <article class="card" id="scenario-s4" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h3>Scenario S4: Interactive Widget State (WCAG 4.1.2 & 2.1.1)</h3>
    </div>
    <div class="card-body">
      <p style="margin-bottom: 1rem; color: var(--text-secondary);">
        Interactive fixture for custom disclosure panels and tab widget state changes using <code>aria-expanded</code> and <code>aria-selected</code>.
      </p>
      <div class="interactive-panel">
        <h4>1. Compliant Disclosure Widget</h4>
        <div style="margin-bottom: 1.5rem;">
          <button id="s4-disclosure-btn" class="disclosure-btn" aria-expanded="false" aria-controls="s4-disclosure-panel">
            <span>Methodology Details</span>
            <span class="disclosure-arrow" aria-hidden="true">&#9656;</span>
          </button>
          <div id="s4-disclosure-panel" class="disclosure-panel" hidden>
            <p>The controlled experiment compares DOM element attributes directly against Chrome DevTools Protocol computed accessibility tree representations.</p>
          </div>
        </div>

        <h4>2. Compliant Tablist Widget</h4>
        <div class="tablist-container">
          <div role="tablist" aria-label="Research Domains" class="tablist">
            <button role="tab" id="tab-dom" aria-selected="true" aria-controls="panel-dom" tabindex="0" class="tab-btn active">DOM Inspection</button>
            <button role="tab" id="tab-ax" aria-selected="false" aria-controls="panel-ax" tabindex="-1" class="tab-btn">AX Tree Inspection</button>
          </div>
          <div id="panel-dom" role="tabpanel" aria-labelledby="tab-dom" class="tabpanel">
            <p>DOM analysis checks HTML syntax, explicit attributes (<code>aria-*</code>, <code>alt</code>, <code>title</code>), and DOM tree relationships without browser layout computations.</p>
          </div>
          <div id="panel-ax" role="tabpanel" aria-labelledby="tab-ax" class="tabpanel" hidden>
            <p>Accessibility Tree analysis inspects the browser-computed node hierarchy exposed via Chrome DevTools Protocol, including computed names and computed roles.</p>
          </div>
        </div>
      </div>
    </div>
  </article>
</div>

<!-- Dynamic Scenario Modals -->
<!-- Compliant Modal (S2) -->
<div id="modal-compliant-s2" class="modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modal-s2-title">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 id="modal-s2-title">Accessible Example Dialog</h3>
      <button id="modal-s2-close-top" class="modal-close" aria-label="Close dialog">&times;</button>
    </div>
    <div class="modal-content">
      <p>This example dialog demonstrates an accessible name, focus movement into the dialog, and focus return when closed.</p>
    </div>
    <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1rem;">
      <button id="modal-s2-cancel" class="btn btn-secondary">Close dialog</button>
      
    </div>
  </div>
</div>

<!-- Defective Modal (S2) -->
<div id="modal-defect-s2" class="modal-overlay" style="display:none;">
  <div class="modal-dialog">
    <h3>Defective Dialog (No Role, No Accessible Name, Focus Not Trapped)</h3>
    <p>This dialog does not move focus inside, does not trap focus, and fails to restore focus on exit.</p>
    <button id="modal-defect-close" class="btn btn-secondary">Dismiss</button>
  </div>
</div>
