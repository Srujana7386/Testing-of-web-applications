<section class="hero-section">
  <div class="hero-content">
    <div class="hero-pills" aria-label="Research areas">
      <span>DOM Analysis</span>
      <span>AX Tree</span>
    </div>
    <h2>Investigating Approaches to Automated Accessibility Conformance Testing</h2>
    <p class="hero-subtitle">
      A prototype comparison of <strong>DOM-Based</strong> and <strong>Accessibility-Tree-Based</strong>
      evaluation against WCAG 2.2 Level AA. The current pilot evaluates static cases only.
      Interactive dynamic scenarios are fixtures; automated dynamic experiments are planned.
    </p>
  </div>
</section>

<section class="research-grid">
  <article class="card">
    <div class="card-header">
      <h3>Artefact Architecture</h3>
    </div>
    <div class="card-body">
      <ul class="feature-list">
        <li><strong>Artefact 1:</strong> SPA Test Bed with dynamic routes, live regions, dialogs, and disclosure widgets.</li>
        <li><strong>Artefact 2:</strong> DOM-Based Conformance Evaluator inspecting raw authored markup, attributes, and relationships.</li>
        <li><strong>Artefact 3:</strong> Accessibility-Tree-Based Evaluator inspecting CDP-computed roles, names, and states.</li>
        <li><strong>Current pilot:</strong> One static evaluation per selected case using the DOM and Accessibility Tree evaluators.</li>
      </ul>
    </div>
  </article>

  <article class="card">
    <div class="card-header">
      <h3>Experimental Parameters</h3>
    </div>
    <div class="card-body">
      <div class="stats-grid">
        <div class="stat-box">
          <span class="stat-number">{{stats.totalCriteria}}</span>
          <span class="stat-label">Target WCAG Criteria</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{{stats.targetDefects}}</span>
          <span class="stat-label">Defect Test Cases</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{{stats.targetControls}}</span>
          <span class="stat-label">Compliant Controls</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{{stats.staticCases}}</span>
          <span class="stat-label">Static Pilot Cases</span>
        </div>
      </div>
    </div>
  </article>
</section>

<section class="criteria-section">
  <h3>Investigated WCAG 2.2 Level AA Success Criteria</h3>
  <div class="criteria-table-container">
    <table class="data-table" aria-label="Targeted WCAG 2.2 Success Criteria">
      <thead>
        <tr>
          <th scope="col">Criterion</th>
          <th scope="col">Name</th>
          <th scope="col">Level</th>
          <th scope="col">Core Inspection Focus</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>1.1.1</strong></td>
          <td>Non-text Content</td>
          <td>Level A</td>
          <td>Alternative text, computed accessible names on images and icons</td>
        </tr>
        <tr>
          <td><strong>1.3.1</strong></td>
          <td>Info and Relationships</td>
          <td>Level A</td>
          <td>Semantic structure, form label associations, headings, lists</td>
        </tr>
        <tr>
          <td><strong>2.1.1</strong></td>
          <td>Keyboard</td>
          <td>Level A</td>
          <td>Keyboard reachability, custom event handlers without keyboard parity</td>
        </tr>
        <tr>
          <td><strong>2.4.2</strong></td>
          <td>Page Titled</td>
          <td>Level A</td>
          <td>Dynamic document title updates upon client-side SPA route transition</td>
        </tr>
        <tr>
          <td><strong>2.4.3</strong></td>
          <td>Focus Order</td>
          <td>Level A</td>
          <td>Logical focus sequence, modal dialog focus containment and restoration</td>
        </tr>
        <tr>
          <td><strong>2.5.3</strong></td>
          <td>Label in Name</td>
          <td>Level A</td>
          <td>Visible text alignment with computed accessible name</td>
        </tr>
        <tr>
          <td><strong>3.3.2</strong></td>
          <td>Labels or Instructions</td>
          <td>Level A</td>
          <td>Explicit and visible labeling of required inputs and controls</td>
        </tr>
        <tr>
          <td><strong>4.1.2</strong></td>
          <td>Name, Role, Value</td>
          <td>Level A</td>
          <td>Proper ARIA roles, computed accessible name, exposed state values</td>
        </tr>
        <tr>
          <td><strong>4.1.3</strong></td>
          <td>Status Messages</td>
          <td>Level AA</td>
          <td>Live regions (<code>aria-live</code>, <code>role="status"</code>) on dynamic feedback</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="scenarios-section">
  <h3>Four Interactive Dynamic Scenario Fixtures</h3>
  <div class="scenario-cards">
    <div class="scenario-card">
      <h4>S1: SPA Route Change</h4>
      <p>Client-side navigation without full-page reload. Focus shift, title updates, view state exposure.</p>
    </div>
    <div class="scenario-card">
      <h4>S2: Modal Dialog</h4>
      <p>Dynamic dialog invocation, accessible name, initial focus entry, focus containment, close restoration.</p>
    </div>
    <div class="scenario-card">
      <h4>S3: Status Message</h4>
      <p>Asynchronous form submission, success/error feedback, live region property inspection vs announcement.</p>
    </div>
    <div class="scenario-card">
      <h4>S4: Widget State</h4>
      <p>Custom disclosure widgets and tab controls. Dynamic expanded/selected state changes and keyboard interaction.</p>
    </div>
  </div>
</section>
