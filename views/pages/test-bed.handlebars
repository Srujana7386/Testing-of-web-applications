<nav aria-label="Breadcrumb" style="margin-bottom: 1rem;">
  <a href="/register" class="nav-link" data-route="register">&larr; Back to Test Register</a>
</nav>

<section class="card" style="margin-bottom: 1.5rem;">
  <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
    <div>
      <span class="brand-badge">{{testCase.wcagCriterion}} (Level {{testCase.wcagLevel}})</span>
      <h2 style="font-size:1.4rem; margin-top:0.35rem;">{{testCase.id}}: {{testCase.name}}</h2>
    </div>
    <div style="display:flex; gap:0.5rem;">
      <span class="badge badge-{{testCase.nature}}">{{testCase.nature}}</span>
      <span class="badge badge-{{testCase.classification}}">{{testCase.classification}}</span>
      <span class="badge badge-outcome-{{testCase.groundTruthStatus}}">Ground Truth: {{testCase.groundTruthStatus}}</span>
    </div>
  </div>
  <div class="card-body">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; font-size:0.9rem; margin-bottom:1rem;">
      <div><strong>Component:</strong> {{testCase.component}}</div>
      <div><strong>Detection Category:</strong> {{testCase.detectionCategory}}</div>
      <div><strong>Machine Testable:</strong> {{#if testCase.machineTestable}}Yes{{else}}Partial / Subject to Human Judgement{{/if}}</div>
      <div><strong>Expected Outcome:</strong> {{testCase.expectedOutcome}}</div>
    </div>
    <div style="background:#f9fafb; border-left:4px solid var(--primary-color); padding:0.75rem 1rem; border-radius:4px; font-size:0.9rem; margin-bottom:0.75rem;">
      <strong>Expected Condition:</strong> {{testCase.expectedCondition}}
    </div>
    <div style="background:#fef2f2; border-left:4px solid var(--danger-color); padding:0.75rem 1rem; border-radius:4px; font-size:0.9rem; margin-bottom:0.75rem;">
      <strong>Failure Condition:</strong> {{testCase.failureCondition}}
    </div>
    <div style="font-size:0.85rem; color:var(--text-secondary);">
      <strong>Manual Verification Evidence:</strong> {{testCase.verificationEvidence}}
    </div>
  </div>
</section>

<section class="card">
  <div class="card-header">
    <h3>Isolated Component Sandbox</h3>
  </div>
  <div class="card-body">
    <div id="test-bed-sandbox" 
         class="test-fixture-sandbox" 
         data-case-id="{{testCase.id}}" 
         data-criterion="{{testCase.wcagCriterion}}" 
         data-classification="{{testCase.classification}}" 
         data-nature="{{testCase.nature}}" 
         data-fixture-ready="true">
      {{{testCase.html}}}
    </div>
  </div>
</section>
